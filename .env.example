# ==============================================================================
# MITHAS SWEETS - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CREDENTIALS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Find these in your Supabase dashboard at: Project Settings > API
#
# SUPABASE_URL: Your project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: The secret 'service_role' key.
# IMPORTANT: This key bypasses Row Level Security (RLS) and is ONLY read on
# the Node/Express server (server.ts). It is NEVER bundled or sent to the frontend.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# Default admin credentials for the Owner Management Portal (/api/admin).
# When Supabase is connected, create this user in Supabase Dashboard > Authentication > Users,
# or use these for development fallback.
ADMIN_EMAIL="admin@mithassweets.com"
ADMIN_PASSWORD="mithas_admin_secret_password"

# ------------------------------------------------------------------------------
# 3. GEMINI AI (HIGH THINKING SOMMELIER)
# ------------------------------------------------------------------------------
# Required for the AI Mithas Sweet Sommelier & Event Portion Calculator (gemini-3.1-pro-preview)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 4. APPLICATION & NETWORKING
# ------------------------------------------------------------------------------
# APP_URL: The public URL of the application
APP_URL="MY_APP_URL"

# PORT: The server port (defaults to 3000)
PORT="3000"
